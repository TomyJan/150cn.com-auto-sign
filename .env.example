# Copy to .env for local use. Never commit real credentials.
SITE_USERNAME=
SITE_PASSWORD=
# Optional Telegram notifications; same names locally and in GitHub Actions Secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional proxy used only for Telegram, e.g. http://127.0.0.1:7890
TELEGRAM_PROXY_URL=
# Optional runtime settings (GitHub Actions repository Variables use the same names).
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
ACTION_DELAY_MIN_MS=500
ACTION_DELAY_MAX_MS=1500
