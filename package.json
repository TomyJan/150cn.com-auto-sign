{
  "name": "150cn-com-auto-sign",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based free server renewal for 150cn.com on GitHub Actions",
  "type": "module",
  "license": "MPL-2.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "start:local": "node --env-file=.env src/cli.mjs",
    "test:unit": "node --test tests/config.test.mjs",
    "test:browser": "node --test tests/site.test.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm test"
  },
  "dependencies": {
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "selfsigned": "5.5.0"
  }
}
